# Entries correspond to *source form IDs*, not translated display labels.
REGIONAL_BASE_IDS = {"darmanitan": "darmanitan-standard"}
REGIONAL_GALAR_IDS = {"darmanitan": "darmanitan-galar-standard"}


def _slug(name: object) -> str:
    s = str(name or "").strip().lower().replace("♀", "-f").replace("♂", "-m")
    s = s.replace("’", "'").replace("'", "").replace(".", "")
    return re.sub(r"[^a-z0-9]+", "-", s).strip("-")


def _parts(name: object) -> tuple[str, str | None]:
    """Return species slug and explicitly chosen regional origin, if any."""
    raw = " ".join(str(name or "").strip().split())
    first, _, rest = raw.partition(" ")
    region = REGION_ALIASES.get(first.casefold())
    if region and rest:
        return _slug(rest), region
    return _slug(raw), None


def normalized_display_name(name: object, *, game: str = "Sword") -> str:
    """Render the regional default without a qualifier, retaining exceptions."""
    raw = " ".join(str(name or "").strip().split())
    base, region = _parts(raw)
    if game.casefold() not in {"sword", "shield", "sword and shield"}:
        return raw
    if region == "galar" and base in REGIONAL_FORMS:
        return raw.split(" ", 1)[1]
    return raw


REGION_LABELS = {
    "kanto": "Kantonian", "alola": "Alolan", "johto": "Johtonian",
    "hoenn": "Hoennian", "unova": "Unovan",
}

