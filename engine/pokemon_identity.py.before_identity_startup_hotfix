# Source PokéAPI's regional labels; Galar is deliberately the bare UI label.
REGION_ALIASES = {
    "galarian": "galar", "kantonian": "kanto", "alolan": "alola",
    "hoennian": "hoenn", "unovan": "unova", "johtonian": "johto",
    "hisuian": "hisui", "paldean": "paldea",
}

AMPED_NATURES = frozenset("hardy brave adamant naughty docile impish lax hasty jolly naive rash sassy quirky".split())
LOW_KEY_NATURES = frozenset("lonely bold relaxed timid serious modest mild quiet bashful calm gentle careful".split())

# Source identifiers that aren't simply hyphenated species names.
DEFAULT_KEYS = {
    "aegislash": "aegislash-shield", "mimikyu": "mimikyu-disguised",
    "eiscue": "eiscue-ice", "morpeko": "morpeko-full-belly",
    "gourgeist": "gourgeist-average", "pumpkaboo": "pumpkaboo-average",
    "wishiwashi": "wishiwashi-solo", "basculin": "basculin-red-striped",
    "frillish": "frillish-male", "jellicent": "jellicent-male",
    "giratina": "giratina-altered", "landorus": "landorus-incarnate",
    "thundurus": "thundurus-incarnate", "tornadus": "tornadus-incarnate",
    "lycanroc": "lycanroc-midday", "keldeo": "keldeo-ordinary",
    "calyrex-ice-rider": "calyrex-ice",
    "calyrex-shadow-rider": "calyrex-shadow",
    "zygarde": "zygarde-50",
    "zygarde-10": "zygarde-10",
    "urshifu-single-strike": "urshifu-single-strike",
    "urshifu-rapid-strike": "urshifu-rapid-strike",
