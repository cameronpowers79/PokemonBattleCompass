def regional_choices(name: object) -> list[str]:
    """Autocomplete choices for a regional species in a Galar Journey."""
    label = normalized_display_name(name)
    base, explicit = _parts(label)
    if explicit is not None:
        label = label.split(" ", 1)[1]
    regions = REGIONAL_FORMS.get(base)
    if not regions:
        return [label]
    default = "galar" if "galar" in regions else ("kanto" if "kanto" in regions else "johto")
    return [label] + [f"{REGION_LABELS[region]} {label}" for region in sorted(regions - {default})]


def regional_types(name: object) -> tuple[str, str] | None:
    """Return the actual type pair for recognized regional forms."""
    base, region = _parts(name)
    if base not in REGIONAL_FORMS:
        return None
    if region is None:
        region = "galar" if "galar" in REGIONAL_FORMS[base] else ("kanto" if "kanto" in REGIONAL_FORMS[base] else "johto")
    return REGIONAL_TYPES.get(base, {}).get(region)


def resolve_pokemon_id(
    name: object, *, gender: object = None, nature: object = None,
    form: object = None, game: str = "Sword",
) -> str | None:
    """Resolve to a PokéAPI Sword/Shield Pokémon key or unknown (None)."""
    base, explicit_region = _parts(name)
    if not base:
        return None
    if base == "urshifu":
        style = _slug(form)
        return f"urshifu-{style}" if style in {"single-strike", "rapid-strike"} else None
    if base in {"indeedee", "meowstic"}:
        gender_key = str(gender or "").strip().casefold()
        return f"{base}-{gender_key}" if gender_key in {"male", "female"} else None
    if base == "toxtricity":
        explicit = _slug(form)
        if explicit in {"amped", "low-key", "lowkey"}:
            return "toxtricity-low-key" if explicit != "amped" else "toxtricity-amped"
        n = str(nature or "").strip().casefold()
        if n in AMPED_NATURES:
            return "toxtricity-amped"
        if n in LOW_KEY_NATURES:
            return "toxtricity-low-key"
        return None
    if base in REGIONAL_FORMS:
        region = explicit_region
        if region is None and game.casefold() in {"sword", "shield", "sword and shield"}:
            region = "galar" if "galar" in REGIONAL_FORMS[base] else ("kanto" if "kanto" in REGIONAL_FORMS[base] else "johto")
        if region not in REGIONAL_FORMS[base]:
            return None
        if region == "galar":
            return REGIONAL_GALAR_IDS.get(base, f"{base}-galar")
        if region == "alola":
            return f"{base}-alola"
        return REGIONAL_BASE_IDS.get(base, base)
    return DEFAULT_KEYS.get(base, base)


def form_from_nature(nature: object) -> str | None:
    n = str(nature or "").strip().casefold()
    return "Amped" if n in AMPED_NATURES else ("Low Key" if n in LOW_KEY_NATURES else None)


def evolution_destination(from_name: object, to_name: object) -> str:
    """Preserve region for same-species regional lines, not new species."""
    source, region = _parts(from_name)
    target, target_region = _parts(to_name)
    if target_region:
        return normalized_display_name(to_name)
    # Special branches from the actual Sword/Shield regional evolution families.
    exceptions = {
        ("meowth", "galar"): "Perrserker", ("meowth", "kanto"): "Persian",
        ("meowth", "alola"): "Alolan Persian",
        ("yamask", "galar"): "Runerigus", ("yamask", "unova"): "Cofagrigus",
        ("farfetchd", "galar"): "Sirfetch'd",
    }
    if (source, region) in exceptions:
        return exceptions[source, region]
    if source in REGIONAL_FORMS and target in REGIONAL_FORMS and region:
        prefix = {"kanto": "Kantonian", "alola": "Alolan", "hoenn": "Hoennian", "unova": "Unovan", "johto": "Johtonian"}.get(region)
        return f"{prefix} {to_name}" if prefix else str(to_name)
    return str(to_name)
